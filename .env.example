# Copy this file to .env and replace placeholders only on your machine.
JLT_DATABASE_URL=sqlite:///data/app.db
JLT_MODEL_BASE_URL=https://your-openai-compatible-proxy.example/v1
JLT_MODEL_API_KEY=replace-with-your-rotated-key
JLT_PRIMARY_MODEL=your-primary-model-id
JLT_FALLBACK_MODEL=your-fallback-model-id
JLT_MODEL_TIMEOUT_SECONDS=180
JLT_PRIMARY_MODEL_TIMEOUT_SECONDS=150
# live (default) | mock (offline fixtures, no keys) | record (append live responses to JSONL)
# JLT_LLM_MODE=mock
# Team accuracy review: right/wrong controls on generated content and an Accuracy page
# JLT_REVIEWER_MODE=true
# Optional per-phase routing for the strict-JSON quiz step. If unset, the app
# routes the quiz phase to the fallback (structured) model first, then the
# primary. Set these to pin explicit models for quiz generation.
# JLT_QUIZ_PRIMARY_MODEL=your-structured-model-id
# JLT_QUIZ_FALLBACK_MODEL=your-primary-model-id
